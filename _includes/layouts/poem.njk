---
layout: layouts/base.njk
---
<article class="detail-card">
  <a href="/#poems" class="back-link">← Back to Poems</a>
  <p class="eyebrow">{{ date | readableDate }}</p>
  <h1>{{ title }}</h1>

  <div class="audio-player" data-src="{{ audio }}">
  <button class="play-btn" aria-label="Play">▶</button>
  <div class="progress-container"><div class="progress-bar"></div></div>
  <span class="time-display">0:00</span>
  <button class="speed-btn" aria-label="Playback speed">1x</button>
  <a class="download-btn" href="{{ audio }}" download aria-label="Download recitation">⬇</a>
</div>

  <div class="detail-content">
    {{ content | safe }}
  </div>
</article>